    "licensesUrl": "https://github.com/lask3802/UNAudio/blob/main/LICENSE",
    "repository": {
        "type": "git",
        "url": "https://github.com/lask3802/UNAudio.git"
    },
    "type": "library",
    "keywords": [
        "audio",
        "native",
        "low-latency",
        "ogg",
        "vorbis",
        "assetbundle",
        "rhythm"
    ],
    "author": {
        "name": "lask3802",
        "url": "https://github.com/lask3802/UNAudio"
    },
    "samples": [
        {
